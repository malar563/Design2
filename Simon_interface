    methods (Access = public)
        function app = Interface_matlab()
            % Initialise les variables
            app.Initialisation()

            % Initialise l'interface
            app.UIFigure = uifigure('Name', 'Controle Simulink', 'Position', [100 100 1100 350]);
            tabs = uitabgroup(app.UIFigure, 'Position', [500 30 485 250]);
            
            % Bouton de dmarrage
            app.StartLabel = labelly(app, "D\'emarrer", [50 300 100 30]);
            app.StartButton = buttonny(app, "X", [20 300 30 30], @(~,~)app.startSimulation());
            
            % Bouton d'arrt
            app.StopLabel = labelly(app, "Arr\^eter", [170 300 100 30]);
            app.StopButton = buttonny(app, "X", [140 300 30 30], @(~,~)app.stopSimulation());
            
            % tat du systme
            app.StatusLabel = labelly(app, "\'Etat : Arr\^et", [240 300 150 30]);

            % Bouton pour graphiques supplmentaires
            app.GraphiqueLabel = labelly(app, "Graphiques suppl\'ementaires", [390 300 200 30]);
            app.GraphiqueButton = buttonny(app, "X", [360 300 30 30], @(~,~)app.set_Graphique());

            % Bouton pour contrle de la boucle
            app.BoucleLabel = labelly(app, "La boucle est ", [600 300 200 30]);
            app.BoucleButton = buttonny(app, "ferm"+char(233)+"e", [680 300 60 30], @(~,~)app.toggleBoucle());
            app.BoucleButton.BackgroundColor = [0, 1, 0]; % Vert

            % Bouton pour contrle du PWM
            app.PwmLabel = labelly(app, "Le PMW est ", [770 300 200 30]);
            app.PwmButton = buttonny(app, "d"+char(233)+"sactiv"+char(233), [845 300 60 30], @(~,~)app.togglepwm());
            app.PwmButton.BackgroundColor = [0, 1, 0]; % Vert

            % Bouton pour enregistrer un csv
            app.CSVLabel = labelly(app, "csv", [1200 300 200 30]);
            app.CSVButton = buttonny(app, "X", [1160 300 30 30], @(~,~)app.Faire_csv());

            % Graphique
            app.UIAxes = uiaxes(app.UIFigure, 'Position', [20 70 460 200]);
            title(app.UIAxes, 'Temp\''erature au laser','Interpreter','latex');
            xlabel(app.UIAxes, 'Temps [s]','Interpreter','latex');
            ylabel(app.UIAxes, 'Temperature [$^\circ$C]','Interpreter','latex');


            % SECTION PLAQUE
            t_plaque = uitab(tabs,"Title","Plaque");
            %t_plaque.Scrollable = 'on';

            % Temprature initiale
            app.InitialTempLabel = labelly_tab(app, t_plaque, "Temp\'erature initiale [$^\circ$C]", [10 200 150 20]);
            app.InitialTempField = fielddy_tab(app, t_plaque, "initialTemp", [10 170 140 30]);

            % Temprature finale
            app.FinalTempLabel = labelly_tab(app, t_plaque, "Temp\'erature finale [$^\circ$C]", [10 140 150 20]);
            app.FinalTempField = fielddy_tab(app, t_plaque, "finalTemp", [10 110 140 30]);
            
            % Temps d'chantillonnage
            app.SamplingTimeLabel = labelly_tab(app, t_plaque, "Temps d'\'echantillonnage [s]", [10 80 160 20]);
            app.SamplingTimeField = fielddy_tab(app, t_plaque, "samplingTime", [10 50 140 30]);


            % SECTION ACTUATEUR??
            % Puissance ferme
            %app.PuissancefermerLabel = labelly(app, "Puissance de l'actuateur [W]", [500 60 160 20]);
            %app.PuissancefermerField = fielddy(app, "Puissancefermer", [500 30 160 30]);


            % SECTION RGULATEUR
            t_reg = uitab(tabs,"Title","R"+char(233)+"gulateur");
            
            % Gain du rgualteur
            app.GainRegLabel = labelly_tab(app, t_reg, "Gain [-]", [10 200 150 20]);
            app.GainRegField = fielddy_tab(app, t_reg, "gainReg", [10 170 140 30]);

            % Constante de temps du rgulateur
            app.TempsRegLabel = labelly_tab(app, t_reg, "Constante de temps [s]", [10 140 150 20]);
            app.TempsRegField = fielddy_tab(app, t_reg, "tempsReg", [10 110 140 30]);

            
            % SECTION RESISTANCE DE PERTURBATION
            t_resistance = uitab(tabs,"Title","R"+char(233)+"sistance de perturbation");

            % Puissance initiale
            app.InitialPowerLabel = labelly_tab(app, t_resistance, "Puissance initiale [W]", [10 200 150 20]);
            app.InitialPowerField = fielddy_tab(app, t_resistance, "initialPower", [10 170 140 30]);

            % Puissance finale
