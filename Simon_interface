        function set_Graphique(app)
         
            figGraph = uifigure('Name', 'Interface Graphique - Slection', 'Position', [100 100 600 400]);
    
            
            graphique = {'erreur', 'Rgulateur', 'PWM', 'Filtre entr','Filtre sortie', ...
                        'Temprature thermistance 1',  ...
                        'Temprature thermistance 2', 'Temprature thermistance 3','TEC', ...
                        'r�sistance thermistance 3', 'Temprature thermistance 1 mesure ', 'Temprature thermistance 2 mesure'};
    
            n = numel(graphique);
            colone = 3;
            range = 4;
            largeur = 140;
            hauteur = 30;
            distance_entre_x = 50;
            distance_entre_y = 20;
            espaceX = (600 - 2*distance_entre_x - colone*largeur) / (colone - 1);
            espaceY = (400 - 2*distance_entre_y - range*hauteur) / (range - 1);
    
            
            for i = 1:n
                col = mod(i-1, colone);
                row = floor((i-1)/colone);
                posX = distance_entre_x + col*(largeur + espaceX);
                posY = 400 - distance_entre_y - row*(hauteur + espaceY) - hauteur;
       
                btn = uibutton(figGraph, 'push', 'Text', graphique{i});
                btn.Position = [posX, posY, largeur, hauteur];
        
                btn.ButtonPushedFcn = @(src, event) app.openGraphInterface(i);
        end
    end
            


        function updatePlot(app)
            if evalin('base', 'exist("Temperature_simulation", "var")')  
                Data = evalin('base', "Temperature_simulation");
                time = Data.Time;
                temp = Data.Data;

                plot(app.UIAxes, time, temp, 'b', 'LineWidth', 2);
                title(app.UIAxes, 'Temprature au laser ');
                xlabel(app.UIAxes, 'Temps (s)');
                ylabel(app.UIAxes, 'Temprature (C)');
                grid(app.UIAxes, 'on');
                end
        end
   

