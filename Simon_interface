    function NomLabel = labelly(app, textLabel, Position)
        NomLabel = uilabel(app.UIFigure, 'Text', textLabel);  
        NomLabel.Position = Position;
        NomLabel.Interpreter = 'latex';
    end

    function NomLabel = labelly_tab(app, parent, textLabel, Position)
        NomLabel = uilabel(parent,"Position",Position);
        NomLabel.Text = textLabel;
        NomLabel.Interpreter = "latex";
    end

    function NomButton = buttonny(app, textButton, Position, Fonction)
        NomButton = uibutton(app.UIFigure, 'push', 'Text', textButton);
        NomButton.Position = Position;
        NomButton.ButtonPushedFcn = Fonction;
    end

    function NomField = fielddy(app, valueField, Position)
        NomField = uieditfield(app.UIFigure, 'numeric');
        NomField.Position = Position;
        NomField.Value = evalin('base', valueField);
        NomField.ValueChangedFcn = @(src, event) assignin('base', valueField, src.Value);
    end

    function NomField = fielddy_tab(app, parent, valueField, Position)
        NomField = uieditfield(parent, 'numeric');
        NomField.Position = Position;
        NomField.Value = evalin('base', valueField);
        NomField.ValueChangedFcn = @(src, event) assignin('base', valueField, src.Value);
    end



