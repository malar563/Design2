    methods (Access = public)
        function app = Interface_matlab()
            % Initialise les variables
            app.Initialisation()

            % Initialise l'interface
            app.UIFigure = uifigure('Name', 'Controle Simulink', 'Position', [100 100 1400 350]);
            app.ErrorLabel = uilabel(app.UIFigure, 'Position', [50 320 400 30], ...
                'Text', '', 'FontColor', [1 0 0]);
             tabs = uitabgroup(app.UIFigure, 'Position', [500 30 850 250]);


            % Bouton de dmarrage
            app.StartLabel = labelly(app, "D\'emarrer", [50 300 100 30]);
            app.StartButton = buttonny(app, "X", [20 300 30 30], @(~,~)app.startSimulation());
            
            % Bouton d'arrt
            %app.StopLabel = labelly(app, "Arr\^eter", [170 300 100 30]);
            %app.StopButton = buttonny(app, "X", [140 300 30 30], @(~,~)app.stopSimulation());
            
            % tat du systme
            app.StatusLabel = labelly(app, "\'Etat : Arr\^et", [120 300 150 30]);

            % Bouton pour graphiques supplmentaires
            app.GraphiqueLabel = labelly(app, "Graphiques suppl\'ementaires", [215 300 200 30]);
            app.GraphiqueButton = buttonny(app, "X", [380 300 30 30], @(~,~)app.set_Graphique());

            % Bouton pour contrle de la boucle
            app.BoucleLabel = labelly(app, "La boucle est ", [430 300 200 30]);
            app.BoucleButton = buttonny(app, "ferm"+char(233)+"e", [510 300 60 30], @(~,~)app.toggleBoucle());
            app.BoucleButton.BackgroundColor = [0, 1, 0]; % Vert

            % Bouton pour contrle du PWM
            app.PwmLabel = labelly(app, "Le PWM est ", [600 300 200 30]);
            app.PwmButton = buttonny(app, "d"+char(233)+"sactiv"+char(233), [675 300 60 30], @(~,~)app.togglepwm());
            app.PwmButton.BackgroundColor = [0, 1, 0]; % Vert

            % Bouton pour enregistrer un csv
            app.CSVLabel = labelly(app, "Enregistrer un CSV", [760 300 200 30]);
            app.CSVButton = buttonny(app, "X", [875 300 30 30], @(~,~)app.Faire_csv());

            % Bouton pour importer un csv
            app.CSV_importLabel = labelly(app, "Importer un CSV", [935 300 200 30]);
            app.CSV_importButton = buttonny(app, "X", [1040 300 30 30], @(~,~)app.Nom_csv());

            % Bouton pour ajouter une 2e temperature desiree
