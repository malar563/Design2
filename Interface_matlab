                 "R\'esistance thermistance 3", "Tension thermistance 2", "Tension thermistance 1", "R\'esistance thermistance 2", "R\'esistance thermistance 1", 'perturbation' };

    
        figNewGraph = uifigure('Name', sprintf('Interface Graphique: %s', graphique{numero_graph}), 'Position', [150 150 500 400]);
