classdef Interface_matlab < matlab.apps.AppBase

    properties (Access = public)
        UIFigure             matlab.ui.Figure
        StartButton          matlab.ui.control.Button
        StopButton           matlab.ui.control.Button
        InitialTempLabel     matlab.ui.control.Label
        InitialTempField     matlab.ui.control.NumericEditField
        FinalTempLabel       matlab.ui.control.Label
        FinalTempField       matlab.ui.control.NumericEditField
        SamplingTimeLabel    matlab.ui.control.Label
        SamplingTimeField    matlab.ui.control.NumericEditField
        InitialPowerLabel    matlab.ui.control.Label
        InitialPowerField    matlab.ui.control.NumericEditField
        FinalPowerLabel      matlab.ui.control.Label
        FinalPowerField      matlab.ui.control.NumericEditField
        InitialTimeLabel     matlab.ui.control.Label
        InitialTimeField     matlab.ui.control.NumericEditField
        GainRegLabel         matlab.ui.control.Label
        GainRegField         matlab.ui.control.NumericEditField
        TempsRegLabel         matlab.ui.control.Label
        TempsRegField         matlab.ui.control.NumericEditField
        StatusLabel          matlab.ui.control.Label
        PlaqueLabel          matlab.ui.control.Label
        ResistanceLabel      matlab.ui.control.Label
        RegulateurLabel      matlab.ui.control.Label
        UIAxes               matlab.ui.control.UIAxes
        ModelName            string = "simulateur_matlab_version21"; 
    end

    properties (Access = private)
        SimulationTimer timer
    end

    methods (Access = private)
        function startSimulation(app)
            load_system(app.ModelName);
            set_param(app.ModelName, 'SimulationCommand', 'start');
            app.StatusLabel.Text = "Etat : En cours";
            
            app.SimulationTimer = timer(...
                'ExecutionMode', 'fixedSpacing', ...
                'Period', 0.2, ... 
                'TimerFcn', @(~,~)app.updatePlot());
            start(app.SimulationTimer);
        end
        
        function stopSimulation(app)
            set_param(app.ModelName, 'SimulationCommand', 'stop');
            app.StatusLabel.Text = "Etat : Arret";
            
            if ~isempty(app.SimulationTimer) && isvalid(app.SimulationTimer)
                stop(app.SimulationTimer);
                delete(app.SimulationTimer);
            end
            app.updatePlot();
        end

        function Initialisation(app)
            initialTemp = 23;
            assignin('base', 'initialTemp', initialTemp);
            finalTemp = 25;
            assignin('base', 'finalTemp', finalTemp);
            samplingTime = 4;
            assignin('base', 'samplingTime', samplingTime);
            initialPower = 0;
            assignin('base', 'initialPower', initialPower);
            finalPower = 0;
            assignin('base', 'finalPower', finalPower);
            initialTime = 0;
            assignin('base', 'initialTime', initialTime);
            gainReg = 0.044317;
            assignin('base', 'gainReg', gainReg);
            tempsReg = 146.07;
            assignin('base', 'tempsReg', tempsReg);
        end


        function updatePlot(app)
            if evalin('base', 'exist("Temperature_simulation", "var")')  
                Data = evalin('base', "Temperature_simulation");
                time = Data.Time;
                temp = Data.Data;

                plot(app.UIAxes, time, temp, 'b', 'LineWidth', 2);
                title(app.UIAxes, 'Temperature au laser');
                xlabel(app.UIAxes, 'Temps (s)');
                ylabel(app.UIAxes, 'Temperature (�C)');
                grid(app.UIAxes, 'on');
            end
        end
    end    

    methods (Access = public)
        function app = Interface_matlab()
            app.Initialisation()
            app.UIFigure = uifigure('Name', 'Controle Simulink', 'Position', [100 100 1100 350]);

            app.StartButton = uibutton(app.UIFigure, 'push', 'Text', 'Demarrer');
            app.StartButton.Position = [20 300 100 30];
            app.StartButton.ButtonPushedFcn = @(~,~)app.startSimulation();

            app.StopButton = uibutton(app.UIFigure, 'push', 'Text', 'Arreter');
            app.StopButton.Position = [140 300 100 30];
            app.StopButton.ButtonPushedFcn = @(~,~)app.stopSimulation();
            
            app.StatusLabel = uilabel(app.UIFigure, 'Text', 'Etat : Arret');
            app.StatusLabel.Position = [260 300 150 30];
            
            app.UIAxes = uiaxes(app.UIFigure, 'Position', [20 70 460 200]);
            title(app.UIAxes, 'Temperature au laser');
            xlabel(app.UIAxes, 'Temps [s]');
            ylabel(app.UIAxes, 'Temperature [°C]');

            app.PlaqueLabel = uilabel(app.UIFigure, 'Text', 'Plaque');
            app.PlaqueLabel.Position = [500 270 160 30];
            app.PlaqueLabel.FontWeight = 'bold';

            app.InitialTempLabel = uilabel(app.UIFigure, 'Text', 'Temperature initiale [�C]');
            app.InitialTempLabel.Position = [500 240 160 20];

            app.InitialTempField = uieditfield(app.UIFigure, 'numeric');
            app.InitialTempField.Position = [500 210 160 30];
            app.InitialTempField.Value = evalin('base', 'initialTemp');
            app.InitialTempField.ValueChangedFcn = @(src, event) assignin('base', 'initialTemp', src.Value);
            
            app.FinalTempLabel = uilabel(app.UIFigure, 'Text', 'Temperature finale [�C]');
            app.FinalTempLabel.Position = [500 180 160 20];

            app.FinalTempField = uieditfield(app.UIFigure, 'numeric');
            app.FinalTempField.Position = [500 150 160 30];
            app.FinalTempField.Value = evalin('base', 'finalTemp');
            app.FinalTempField.ValueChangedFcn = @(src, event) assignin('base', 'finalTemp', src.Value);
            
            app.SamplingTimeLabel = uilabel(app.UIFigure, 'Text', "Temps d'echantillonnage [s]");
            app.SamplingTimeLabel.Position = [500 120 160 20];

            app.SamplingTimeField = uieditfield(app.UIFigure, 'numeric');
            app.SamplingTimeField.Position = [500 90 160 30];
            app.SamplingTimeField.Value = evalin('base', 'samplingTime');
            app.SamplingTimeField.ValueChangedFcn = @(src, event) assignin('base', 'samplingTime', src.Value);
             
            app.ResistanceLabel = uilabel(app.UIFigure, 'Text', 'Resistance de perturbation');
            app.ResistanceLabel.Position = [830 270 160 30];
            app.ResistanceLabel.FontWeight = 'bold';

            app.InitialPowerLabel = uilabel(app.UIFigure, 'Text', 'Puissance initiale [W]');
            app.InitialPowerLabel.Position = [830 240 160 20];

            app.InitialPowerField = uieditfield(app.UIFigure, 'numeric');
            app.InitialPowerField.Position = [830 210 160 30];
            app.InitialPowerField.Value = evalin('base', 'initialPower');
            app.InitialPowerField.ValueChangedFcn = @(src, event) assignin('base', 'initialPower', src.Value);
            
            app.FinalPowerLabel = uilabel(app.UIFigure, 'Text', 'Puissance finale [W]');
            app.FinalPowerLabel.Position = [830 180 160 20];

            app.FinalPowerField = uieditfield(app.UIFigure, 'numeric');
            app.FinalPowerField.Position = [830 150 160 30];
            app.FinalPowerField.Value = evalin('base', 'finalPower');
            app.FinalPowerField.ValueChangedFcn = @(src, event) assignin('base', 'finalPower', src.Value);
            
            app.InitialTimeLabel = uilabel(app.UIFigure, 'Text', "Temps de demarrage [s]");
            app.InitialTimeLabel.Position = [830 120 160 20];

            app.InitialTimeField = uieditfield(app.UIFigure, 'numeric');
            app.InitialTimeField.Position = [830 90 160 30];
            app.InitialTimeField.Value = evalin('base', 'initialTime');
            app.InitialTimeField.ValueChangedFcn = @(src, event) assignin('base', 'initialTime', src.Value);

            app.RegulateurLabel = uilabel(app.UIFigure, 'Text', 'Regulateur');
            app.RegulateurLabel.Position = [670 270 150 30]; 
            app.RegulateurLabel.FontWeight = 'bold';

            app.GainRegLabel = uilabel(app.UIFigure, 'Text', 'Gain [-]');
            app.GainRegLabel.Position = [670 240 150 20];

            app.GainRegField = uieditfield(app.UIFigure, 'numeric');
            app.GainRegField.Position = [670 210 150 30];
            app.GainRegField.Value = evalin('base', 'gainReg');
            app.GainRegField.ValueChangedFcn = @(src, event) assignin('base', 'gainReg', src.Value);

            app.TempsRegLabel = uilabel(app.UIFigure, 'Text', 'Constante de temps [s]');
            app.TempsRegLabel.Position = [670 180 150 20];

            app.TempsRegField = uieditfield(app.UIFigure, 'numeric');
            app.TempsRegField.Position = [670 150 150 30];
            app.TempsRegField.Value = evalin('base', 'tempsReg');
            app.TempsRegField.ValueChangedFcn = @(src, event) assignin('base', 'tempsReg', src.Value);
            
        end
    end
end