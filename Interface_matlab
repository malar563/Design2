    methods (Access = public)
        function app = Interface_matlab()
            % Positionne les boutons dans l'interface de base
            app.Initialisation()
            app.UIFigure = uifigure('Name', 'Controle Simulink', 'Position', [100 100 1100 350]);
            
            % Bouton de démarrage
            app.StartLabel = labelly(app, "D\'emarrer", [50 300 100 30]);
            app.StartButton = buttonny(app, "X", [20 300 30 30], @(~,~)app.startSimulation());
            
            % Bouton d'arrêt
            app.StopLabel = labelly(app, "Arr\^eter", [170 300 100 30]);
            app.StopButton = buttonny(app, "X", [140 300 30 30], @(~,~)app.stopSimulation());
            
            % État du système
            app.StatusLabel = labelly(app, "\'Etat : Arr\^et", [240 300 150 30]);

            % Bouton pour graphiques supplémentaires
            app.GraphiqueLabel = labelly(app, "Graphiques suppl\'ementaires", [390 300 200 30]);
            app.GraphiqueButton = buttonny(app, "X", [360 300 30 30], @(~,~)app.set_Graphique());

            % Bouton pour contrôle de la boucle
            app.BoucleLabel = labelly(app, "La boucle est ", [600 300 200 30]);
            app.BoucleButton = buttonny(app, "fermée", [680 300 60 30], @(~,~)app.toggleBoucle());
            app.BoucleButton.BackgroundColor = [0, 1, 0]; % Vert

            % Bouton pour contrôle du PWM
            app.PwmLabel = labelly(app, "Le PMW est ", [770 300 200 30]);
            app.PwmButton = buttonny(app, "désactivé", [845 300 60 30], @(~,~)app.togglepwm());
            app.PwmButton.BackgroundColor = [0, 1, 0]; % Vert

            % Bouton pour enregistrer un csv
            app.CSVLabel = labelly(app, "csv", [1200 300 200 30]);
            app.CSVButton = buttonny(app, "X", [1160 300 30 30], @(~,~)app.Faire_csv());

            % Graphique
            app.UIAxes = uiaxes(app.UIFigure, 'Position', [20 70 460 200]);
            title(app.UIAxes, 'Temp\''erature au laser','Interpreter','latex');
            xlabel(app.UIAxes, 'Temps [s]','Interpreter','latex');
            ylabel(app.UIAxes, 'Temperature [$^\circ$C]','Interpreter','latex');


            % SECTION RÉGULATEUR
            app.RegulateurLabel = labelly(app, "\textbf{R\'egulateur}", [670 260 150 30]);
            
            % Gain du régualteur
            app.GainRegLabel = labelly(app, "Gain [-]", [670 240 150 20]);
            app.GainRegField = fielddy(app, "gainReg", [670 210 150 30]);

            % Constante de temps du régulateur
            app.TempsRegLabel = labelly(app, "Constante de temps [s]", [670 180 150 20]);
            app.TempsRegField = fielddy(app, "tempsReg", [670 150 150 30]);


            % SECTION PLAQUE
            app.PlaqueLabel = labelly(app, "\textbf{Plaque}", [500 260 160 30]);

            % Température initiale
            app.InitialTempLabel = labelly(app, "Temp\'erature initiale [$^\circ$C]", [500 240 160 20]);
            app.InitialTempField = fielddy(app, "initialTemp", [500 210 160 30]);

            % Température finale
            app.FinalTempLabel = labelly(app, "Temp\'erature finale [$^\circ$C]", [500 180 160 20]);
            app.FinalTempField = fielddy(app, "finalTemp", [500 150 160 30]);
            
            % Temps d'échantillonnage
            app.SamplingTimeLabel = labelly(app, "Temps d'\'echantillonnage [s]", [500 120 160 20]);
            app.SamplingTimeField = fielddy(app, "samplingTime", [500 90 160 30]);

            % SECTION RESISTANCE DE PERTURBATION
            app.ResistanceLabel = labelly(app, "\textbf{R\'esistance de perturbation}", [830 260 170 30]);

            % Puissance initiale
            app.InitialPowerLabel = labelly(app, "Puissance initale [W]", [830 240 160 20]);
            app.InitialPowerField = fielddy(app, "initialPower", [830 210 160 30]);

            % Puissance finale
            app.FinalPowerLabel = labelly(app, "Puissance finale [W]", [830 180 160 20]);
            app.FinalPowerField = fielddy(app, "finalPower", [830 150 160 30]);

            % Temps de démarrage
            app.InitialTimeLabel = labelly(app, "Temps de d\'emarrage [s]", [830 120 160 20]);
            app.InitialTimeField = fielddy(app, "initialTime", [830 90 160 30]);
            
            
            % SECTION VARIABLE DE LA SIMULATION
