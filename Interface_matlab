    methods (Access = private)
        function startSimulation(app)
            load_system(app.ModelName);
            set_param(app.ModelName, 'SimulationCommand', 'start');
            app.StatusLabel.Text = "Etat : En cours";
            
            app.SimulationTimer = timer(...
                'ExecutionMode', 'fixedSpacing', ...
                'Period', 0.2, ... 
                'TimerFcn', @(~,~)app.updatePlot());
            start(app.SimulationTimer);
        end
        
        function stopSimulation(app)
            set_param(app.ModelName, 'SimulationCommand', 'stop');
            app.StatusLabel.Text = "Etat : Arret";
            
            if ~isempty(app.SimulationTimer) && isvalid(app.SimulationTimer)
                stop(app.SimulationTimer);
                delete(app.SimulationTimer);
            end
            app.updatePlot();
        end

        function Initialisation(app)
            initialTemp = 23;
            assignin('base', 'initialTemp', initialTemp);
            finalTemp = 25;
            assignin('base', 'finalTemp', finalTemp);
            samplingTime = 4;
            assignin('base', 'samplingTime', samplingTime);
            initialPower = 0;
            assignin('base', 'initialPower', initialPower);
            finalPower = 0;
            assignin('base', 'finalPower', finalPower);
            initialTime = 0;
            assignin('base', 'initialTime', initialTime);
            gainReg = 0.044317;
            assignin('base', 'gainReg', gainReg);
            tempsReg = 146.07;
            assignin('base', 'tempsReg', tempsReg);
        end
        function Graphique(app)
           
           title = 'Graphique';
           dims = [1 35];
           definput = {'0'};
           answer = inputdlg(prompt, title, dims, definput);
           if ~isempty(answer)
               initialTime = str2double(answer{1});
               assignin('base', 'initialTime', initialTime);
            end
        end
        function set_Graphique(app)
         
            figGraph = uifigure('Name', 'Interface Graphique - Selection', 'Position', [100 100 600 400]);
    
            
            graphique = {'erreur', 'Regulateur', 'PWM', 'Filtre entree','Filtre sortie', ...
                        'Temperature thermistance 1',  ...
                        'Temperature thermistance 2', 'Temperature thermistance 3','TEC', ...
                        'resistance thermistance 3', 'Temperature thermistance 1 mesuree ', 'Temperature thermistance 2 mesuree'};
    
            n = numel(graphique);
            colone = 3;
            range = 4;
            largeur = 140;
            hauteur = 30;
            distance_entre_x = 50;
            distance_entre_y = 20;
            espaceX = (600 - 2*distance_entre_x - colone*largeur) / (colone - 1);
            espaceY = (400 - 2*distance_entre_y - range*hauteur) / (range - 1);
    
            
            for i = 1:n
                col = mod(i-1, colone);
                row = floor((i-1)/colone);
                posX = distance_entre_x + col*(largeur + espaceX);
                posY = 400 - distance_entre_y - row*(hauteur + espaceY) - hauteur;
       
                btn = uibutton(figGraph, 'push', 'Text', graphique{i});
                btn.Position = [posX, posY, largeur, hauteur];
        
                btn.ButtonPushedFcn = @(src, event) app.openGraphInterface(i);
        end
    end
        function updatePlot(app)
            if evalin('base', 'exist("Temperature_simulation", "var")')  
                Data = evalin('base', "Temperature_simulation");
                time = Data.Time;
                temp = Data.Data;

                plot(app.UIAxes, time, temp, 'b', 'LineWidth', 2);
                title(app.UIAxes, 'Temperature au laser');
                xlabel(app.UIAxes, 'Temps (s)');
                ylabel(app.UIAxes, 'Temperature (�C)');
                grid(app.UIAxes, 'on');
                end
        end
   

